# Copy to .env.development (local) or set these in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are built into the site, so redeploy after changing them.

# Your website's own address (used for links, the sitemap and social sharing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Your backend. The bare host is enough, e.g. https://citadel-api.up.railway.app — /api/v1 is added automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Supabase project (public, browser-safe values). Needed for sign-in and live notifications.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Tag Manager container ID (e.g. GTM-TNVS56ZK). If set, it is used instead of NEXT_PUBLIC_GA_ID.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# Server-only. If the API can't be reached: "seed" shows the built-in copy of The Citadel, "none" shows nothing.
CONTENT_FALLBACK=seed
