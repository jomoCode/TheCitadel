# Copy to .env.development (local) or set these in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are built into the site, so redeploy after changing them.

# Your website's own address (used for links, the sitemap and social sharing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Your backend. The bare host is enough, e.g. https://citadel-api.up.railway.app — /api/v1 is added automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Which website this is on the backend (sent as X-Website-Id). Leave as "citadel" for The Citadel.
NEXT_PUBLIC_WEBSITE_ID=citadel
# Whose journal to show. Every estate site shares The Citadel's journal (managed once in the admin).
NEXT_PUBLIC_JOURNAL_WEBSITE_ID=citadel
# Google Tag Manager container ID (e.g. GTM-TNVS56ZK). If set, it is used instead of NEXT_PUBLIC_GA_ID.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
# Standard analytics (schema v3) go to <NEXT_PUBLIC_API_URL>/api/v1/public/analytics/events automatically.
# Set a different address here, or "off" to only log events in the browser console.
# Visit the site once with ?internal=1 to exclude your own browser from analytics (?internal=0 to undo).
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Server-only. If the API can't be reached: "seed" shows the built-in copy of The Citadel, "none" shows nothing.
CONTENT_FALLBACK=seed
